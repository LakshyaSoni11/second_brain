# Server
PORT=3001
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Required
JWT_SECRET=change_me_long_random_string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/secondBrain?retryWrites=true&w=majority

# AI (Groq) — optional; without it agents fall back to deterministic responses
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OAuth — optional, leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP — optional; if unset, email verification is skipped (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Second Brain <noreply@example.com>